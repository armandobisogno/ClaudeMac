{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": ["Bash(git push:*)", "Bash(git pull:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/brain/tools/session_brief.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Brief di inizio sessione…"
          }
        ]
      }
    ]
  }
}
