: 204.28, "text": "questo ufficio, tratto questa informazione come se fosse un dato, 300", "words": [[198.3, 198.54, " questo"], [198.54, 199.54, " ufficio,"], [199.54, 200.48, " tratto"], [200.48, 201.16, " questa"], [201.16, 202.0, " informazione"], [202.0, 202.26, " come"], [202.26, 202.42, " se"], [202.42, 202.62, " fosse"], [202.62, 203.08, " un"], [203.08, 203.48, " dato,"], [203.88, 204.28, " 300"]]}, {"start": 204.28, "end": 211.14, "text": "persone sono passate. Nella realtà non sono 300 persone che sono passate, sono", "words": [[204.28, 204.9, " persone"], [204.9, 205.18, " sono"], [205.18, 205.82, " passate."], [206.22, 206.58, " Nella"], [206.58, 207.04, " realtà"], [207.04, 207.72, " non"], [207.72, 208.26, " sono"], [208.26, 208.82, " 300"], [208.82, 209.54, " persone"], [209.54, 209.66, " che"], [209.66, 209.88, " sono"], [209.88, 210.54, " passate,"], [210.92, 211.14, " sono"]]}, {"start": 211.14, "end": 216.6, "text": "320 singoli relativi ad una persona o a più persone che si sono", "words": [[211.14, 211.84, " 320"], [211.84, 213.0, " singoli"], [213.0, 213.8, " relativi"], [213.8, 213.92, " ad"], [213.92, 214.08, " una"], [214.08, 214.46, " persona"], [214.46, 214.88, " o"], [214.88, 214.92, " a"], [214.92, 215.06, " più"], [215.06, 215.68, " persone"], [215.68, 216.12, " che"], [216.12, 216.26, " si"], [216.26, 216.6, " sono"]]}, {"start": 216.6, "end": 223.0, "text": "susseguiti nel corso di un arco di tempo più o meno predefinito, diventano un dato", "words": [[216.6, 217.26, " susseguiti"], [217.26, 217.44, " nel"], [217.44, 217.8, " corso"], [217.8, 217.94, " di"], [217.94, 218.04, " un"], [218.04, 218.48, " arco"], [218.48, 218.96, " di"], [218.96, 219.44, " tempo"], [219.44, 220.08, " più"], [220.08, 220.16, " o"], [220.16, 220.3, " meno"], [220.3, 221.48, " predefinito,"], [221.74, 222.22, " diventano"], [222.22, 222.62, " un"], [222.62, 223.0, " dato"]]}, {"start": 223.0, "end": 228.04, "text": "quando qualcuno li registra. Cioè quando 