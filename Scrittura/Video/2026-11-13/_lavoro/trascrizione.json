[{"start": 14.32, "end": 18.96, "text": "Nelle mie riflessioni mi occupo sempre il rapporto tra discipline umanistiche e", "words": [[14.32, 14.66, " Nelle"], [14.66, 14.8, " mie"], [14.8, 15.44, " riflessioni"], [15.44, 15.9, " mi"], [15.9, 16.32, " occupo"], [16.32, 16.54, " sempre"], [16.54, 16.9, " il"], [16.9, 17.36, " rapporto"], [17.36, 17.56, " tra"], [17.56, 18.08, " discipline"], [18.08, 18.78, " umanistiche"], [18.78, 18.96, " e"]]}, {"start": 18.96, "end": 24.3, "text": "trasrapedi umanistici nuove tecnologie. Oggi lo faccio partendo da un paper di", "words": [[18.96, 19.3, " trasrapedi"], [19.3, 19.94, " umanistici"], [19.94, 20.2, " nuove"], [20.2, 20.84, " tecnologie."], [21.46, 21.9, " Oggi"], [21.9, 22.02, " lo"], [22.02, 22.42, " faccio"], [22.42, 22.92, " partendo"], [22.92, 23.14, " da"], [23.14, 23.34, " un"], [23.34, 23.66, " paper"], [23.66, 24.3, " di"]]}, {"start": 24.3, "end": 29.12, "text": "Johanna Drucker che insegna l'Università della California di Los Angeles e che", "words": [[24.3, 24.98, " Johanna"], [24.98, 25.68, " Drucker"], [25.68, 26.06, " che"], [26.06, 26.82, " insegna"], [26.82, 26.94, " l"], [26.94, 27.4, "'Università"], [27.4, 27.56, " della"], [27.56, 27.92, " California"], [27.92, 28.2, " di"], [28.2, 28.34, " Los"], [28.34, 28.72, " Angeles"], [28.72, 29.06, " e"], [29.06, 29.12, " che"]]}, {"start": 29.12, "end": 32.4, "text": "si occupa del rapporto tra materiali umanistiche e tra discipline", "words": [[29.12, 29.24, " si"], [29.24, 29.6, " occupa"], [29.6, 29.74, " del"], [29.74, 30.32, " rapporto"], [30.32, 30.52, " tra"], [30.52, 31.36, " materiali"], [31.36, 31.88, " umanistiche"], [31.88, 32.06, " e"], [32.06, 32.06, " tra"], [32.06, 32.4, " discipline"]]}, {"start": 32.4, "end": 38.0, "text": "umanistiche e rappresentazioni grafiche. Al di là del merito del paper c'è una", "words": [[32.4, 33.08, " umanistiche"], [33.08, 33.22, " e"], [33.22, 33.96, " rappresentazioni"], [33.96, 34.54, " grafiche."], [35.28, 35.62, " Al"], [35.62, 35.68, " di"], [35.68, 35.78, " là"], [35.78, 35.98, " del"], [35.98, 36.4, " merito"], [36.4, 36.66, " del"], [36.66, 37.08, " paper"], [37.08, 37.78, " c"], [37.78, 37.86, "'è"], [37.86, 38.0, " una"]]}, {"start": 38.0, "end": 41.46, "text": "premessa generale che la Drucker fa e che secondo me è particolarmente", "words": [[38.0, 38.34, " premessa"], [38.34, 38.98, " generale"], [38.98, 39.16, " che"], [39.16, 39.28, " la"], [39.28, 39.76, " Drucker"], [39.76, 40.04, " fa"], [40.04, 40.22, " e"], [40.22, 40.28, " che"], [40.28, 40.48, " secondo"], [40.48, 40.7, " me"], [40.7, 40.78, " è"], [40.78, 41.46, " particolarmente"]]}, {"start": 41.46, "end": 46.26, "text": "interessante. Parte dal presupposto che noi viviamo in un'epoca di", "words": [[41.46, 42.02, " interessante."], [43.6, 44.1, " Parte"], [44.1, 44.3, " dal"], [44.3, 44.84, " presupposto"], [44.84, 45.04, " che"], [45.04, 45.2, " noi"], [45.2, 45.6, " viviamo"], [45.6, 45.74, " in"], [45.74, 45.82, " un"], [45.82, 46.08, "'epoca"], [46.08, 46.26, " di"]]}, {"start": 46.26, "end": 50.66, "text": "datificazione che è una cosa della quale ci rendiamo conto tutti in ogni", "words": [[46.26, 47.2, " datificazione"], [47.2, 47.46, " che"], [47.46, 47.58, " è"], [47.58, 47.7, " una"], [47.7, 47.86, " cosa"], [47.86, 48.04, " della"], [48.04, 48.58, " quale"], [48.58, 49.1, " ci"], [49.1, 49.38, " rendiamo"], [49.38, 49.78, " conto"], [49.78, 50.24, " tutti"], [50.24, 50.52, " in"], [50.52, 50.66, " ogni"]]}, {"start": 50.66, "end": 54.94, "text": "momento perché produciamo o siamo dati quando usiamo il telefono quando facciamo", "words": [[50.66, 51.04, " momento"], [51.04, 51.4, " perché"], [51.4, 52.04, " produciamo"], [52.04, 52.22, " o"], [52.22, 52.38, " siamo"], [52.38, 53.16, " dati"], [53.16, 53.5, " quando"], [53.5, 53.8, " usiamo"], [53.8, 53.96, " il"], [53.96, 54.34, " telefono"], [54.34, 54.58, " quando"], [54.58, 54.94, " facciamo"]]}, {"start": 54.94, "end": 57.96, "text": "un pagamento elettronico quando passiamo davanti una videocamera di", "words": [[54.94, 55.08, " un"], [55.08, 55.32, " pagamento"], [55.32, 55.98, " elettronico"], [55.98, 56.18, " quando"], [56.18, 56.62, " passiamo"], [56.62, 57.04, " davanti"], [57.04, 57.28, " una"], [57.28, 57.88, " videocamera"], [57.88, 57.96, " di"]]}, {"start": 57.96, "end": 63.0, "text": "sorvegliarsi e così via. Questa datificazione cioè il fatto che", "words": [[57.96, 58.52, " sorvegliarsi"], [58.52, 58.66, " e"], [58.66, 58.78, " così"], [58.78, 59.2, " via."], [60.28, 60.56, " Questa"], [60.56, 61.78, " datificazione"], [61.78, 62.34, " cioè"], [62.34, 62.52, " il"], [62.52, 62.68, " fatto"], [62.68, 63.0, " che"]]}, {"start": 63.0, "end": 67.56, "text": "continuamente siamo immersi nella produzione e nell'uso di dati ha", "words": [[63.0, 63.96, " continuamente"], [63.96, 64.26, " siamo"], [64.26, 64.84, " immersi"], [64.84, 65.04, " nella"], [65.04, 65.62, " produzione"], [65.62, 65.8, " e"], [65.8, 65.9, " nell"], [65.9, 66.24, "'uso"], [66.24, 66.92, " di"], [66.92, 67.4, " dati"], [67.4, 67.56, " ha"]]}, {"start": 67.56, "end": 71.32, "text": "creato secondo Drucker una sorta di grande mitologia. I dati sono", "words": [[67.56, 67.86, " creato"], [67.86, 68.12, " secondo"], [68.12, 68.7, " Drucker"], [68.7, 68.9, " una"], [68.9, 69.14, " sorta"], [69.14, 69.34, " di"], [69.34, 69.52, " grande"], [69.52, 70.18, " mitologia."], [70.74, 70.78, " I"], [70.78, 71.1, " dati"], [71.1, 71.32, " sono"]]}, {"start": 71.32, "end": 76.92, "text": "il nuovo petrolio, le decisioni vanno prese facendoci guidare dai dati e questa", "words": [[71.32, 71.54, " il"], [71.54, 71.7, " nuovo"], [71.7, 72.4, " petrolio,"], [72.84, 73.04, " le"], [73.04, 73.48, " decisioni"], [73.48, 73.7, " vanno"], [73.7, 74.18, " prese"], [74.18, 74.72, " facendoci"], [74.72, 75.1, " guidare"], [75.1, 75.38, " dai"], [75.38, 75.94, " dati"], [75.94, 76.66, " e"], [76.66, 76.92, " questa"]]}, {"start": 76.92, "end": 82.42, "text": "mitologia ha suggerito in maniera più o meno sotterranea che i dati fossero", "words": [[76.92, 77.54, " mitologia"], [77.54, 78.18, " ha"], [78.18, 79.44, " suggerito"], [79.44, 79.56, " in"], [79.56, 79.84, " maniera"], [79.84, 80.12, " più"], [80.12, 80.24, " o"], [80.24, 80.28, " meno"], [80.28, 81.34, " sotterranea"], [81.34, 81.62, " che"], [81.62, 81.74, " i"], [81.74, 82.0, " dati"], [82.0, 82.42, " fossero"]]}, {"start": 82.42, "end": 87.54, "text": "affidabili perché sono oggettivi cioè perché sono una registrazione", "words": [[82.42, 83.08, " affidabili"], [83.08, 83.32, " perché"], [83.32, 83.64, " sono"], [83.64, 84.76, " oggettivi"], [84.76, 85.54, " cioè"], [85.54, 85.78, " perché"], [85.78, 86.02, " sono"], [86.02, 86.26, " una"], [86.26, 87.54, " registrazione"]]}, {"start": 87.54, "end": 94.52, "text": "neutrale della realtà. Se davanti una videocamera passano 300 persone in un", "words": [[87.54, 88.84, " neutrale"], [88.84, 89.82, " della"], [89.82, 90.38, " realtà."], [91.24, 91.24, " Se"], [91.24, 91.76, " davanti"], [91.76, 91.9, " una"], [91.9, 92.5, " videocamera"], [92.5, 93.02, " passano"], [93.02, 93.3, " 300"], [93.3, 94.0, " persone"], [94.0, 94.36, " in"], [94.36, 94.52, " un"]]}, {"start": 94.52, "end": 98.42, "text": "giorno quel numero 300 non è nient'altro che la registrazione", "words": [[94.52, 94.82, " giorno"], [94.82, 95.36, " quel"], [95.36, 95.64, " numero"], [95.64, 96.12, " 300"], [96.12, 96.56, " non"], [96.56, 96.7, " è"], [96.7, 97.06, " nient"], [97.06, 97.34, "'altro"], [97.34, 97.58, " che"], [97.58, 97.72, " la"], [97.72, 98.42, " registrazione"]]}, {"start": 98.42, "end": 101.46, "text": "oggettiva di quello che è realmente successo.", "words": [[98.42, 99.22, " oggettiva"], [99.22, 99.36, " di"], [99.36, 99.6, " quello"], [99.6, 99.82, " che"], [99.82, 99.96, " è"], [99.96, 100.34, " realmente"], [100.34, 101.46, " successo."]]}, {"start": 102.22, "end": 107.72, "text": "Drucker suggerisce specia che non è così, cioè che i dati non sono mai", "words": [[102.22, 102.82, " Drucker"], [102.82, 103.42, " suggerisce"], [103.42, 103.42, " specia"], [103.42, 104.2, " che"], [104.2, 104.34, " non"], [104.34, 104.5, " è"], [104.5, 104.72, " così,"], [105.5, 105.72, " cioè"], [105.72, 105.86, " che"], [105.86, 106.0, " i"], [106.0, 106.44, " dati"], [106.44, 106.72, " non"], [106.72, 107.06, " sono"], [107.06, 107.72, " mai"]]}, {"start": 107.72, "end": 115.98, "text": "ne neutrali o oggettivi e per spiegacelo utilizza due linee, due elementi,", "words": [[107.72, 107.92, " ne"], [107.92, 108.6, " neutrali"], [108.6, 108.76, " o"], [108.76, 109.66, " oggettivi"], [109.66, 110.24, " e"], [110.24, 110.42, " per"], [110.42, 111.24, " spiegacelo"], [111.24, 113.14, " utilizza"], [113.14, 113.82, " due"], [113.82, 115.48, " linee,"], [115.52, 115.68, " due"], [115.68, 115.98, " elementi,"]]}, {"start": 116.66, "end": 120.44, "text": "cioè individua due motivi per i quali i dati sicuramente non sono ne neutrali", "words": [[116.66, 116.7, " cioè"], [116.7, 117.12, " individua"], [117.12, 117.38, " due"], [117.38, 117.82, " motivi"], [117.82, 117.94, " per"], [117.94, 118.02, " i"], [118.02, 118.32, " quali"], [118.32, 118.44, " i"], [118.44, 118.82, " dati"], [118.82, 119.5, " sicuramente"], [119.5, 119.72, " non"], [119.72, 119.9, " sono"], [119.9, 120.02, " ne"], [120.02, 120.44, " neutrali"]]}, {"start": 120.44, "end": 123.74, "text": "oggettivi, usiamo un esempio per spiegarlo meglio.", "words": [[120.44, 121.08, " oggettivi,"], [121.28, 121.94, " usiamo"], [121.94, 122.08, " un"], [122.08, 122.44, " esempio"], [122.44, 122.78, " per"], [122.78, 123.4, " spiegarlo"], [123.4, 123.74, " meglio."]]}, {"start": 123.74, "end": 128.2, "text": "Posiamo che ci sia una videocamera e sorveglianza di fronte all'ingresso di un", "words": [[123.74, 124.16, " Posiamo"], [124.16, 124.36, " che"], [124.36, 124.48, " ci"], [124.48, 124.7, " sia"], [124.7, 124.9, " una"], [124.9, 125.48, " videocamera"], [125.48, 125.56, " e"], [125.56, 126.48, " sorveglianza"], [126.48, 127.02, " di"], [127.02, 127.42, " fronte"], [127.42, 127.54, " all"], [127.54, 127.8, "'ingresso"], [127.8, 128.08, " di"], [128.08, 128.2, " un"]]}, {"start": 128.2, "end": 133.16, "text": "ufficio, che registra gli ingressi e le uscite delle persone in questo", "words": [[128.2, 128.72, " ufficio,"], [128.74, 128.84, " che"], [128.84, 129.78, " registra"], [129.78, 130.56, " gli"], [130.56, 131.02, " ingressi"], [131.02, 131.1, " e"], [131.1, 131.16, " le"], [131.16, 131.56, " uscite"], [131.56, 131.88, " delle"], [131.88, 132.5, " persone"], [132.5, 132.86, " in"], [132.86, 133.16, " questo"]]}, {"start": 133.16, "end": 139.5, "text": "ufficio. Punto primo, quella videocamera non sta lì per caso né per motivi", "words": [[133.16, 133.82, " ufficio."], [134.18, 134.6, " Punto"], [134.6, 134.86, " primo,"], [136.18, 136.46, " quella"], [136.46, 137.1, " videocamera"], [137.1, 137.34, " non"], [137.34, 137.54, " sta"], [137.54, 137.76, " lì"], [137.76, 137.98, " per"], [137.98, 138.38, " caso"], [138.38, 138.92, " né"], [138.92, 139.12, " per"], [139.12, 139.5, " motivi"]]}, {"start": 139.5, "end": 144.76, "text": "naturali. Qualcuno ce l'ha ammessa perché riteneva importante,", "words": [[139.5, 140.14, " naturali."], [140.3, 140.58, " Qualcuno"], [140.58, 140.74, " ce"], [140.74, 140.84, " l"], [140.84, 140.86, "'ha"], [140.86, 141.26, " ammessa"], [141.26, 142.88, " perché"], [142.88, 143.92, " riteneva"], [143.92, 144.76, " importante,"]]}, {"start": 145.18, "end": 149.52, "text": "utile, necessario registrare gli ingressi in quell'ufficio. Non ci", "words": [[145.18, 145.66, " utile,"], [145.8, 146.34, " necessario"], [146.34, 147.02, " registrare"], [147.02, 147.3, " gli"], [147.3, 147.86, " ingressi"], [147.86, 148.0, " in"], [148.0, 148.2, " quell"], [148.2, 148.62, "'ufficio."], [149.1, 149.36, " Non"], [149.36, 149.52, " ci"]]}, {"start": 149.52, "end": 152.92, "text": "interessano le motivazioni se sono tossiche, non tossiche, se sono di", "words": [[149.52, 150.06, " interessano"], [150.06, 150.18, " le"], [150.18, 150.86, " motivazioni"], [150.86, 151.08, " se"], [151.08, 151.32, " sono"], [151.32, 151.86, " tossiche,"], [151.96, 152.02, " non"], [152.02, 152.52, " tossiche,"], [152.64, 152.64, " se"], [152.64, 152.8, " sono"], [152.8, 152.92, " di"]]}, {"start": 152.92, "end": 157.5, "text": "controllo, di verifica, quello che ci interessa è che c'è una", "words": [[152.92, 153.54, " controllo,"], [153.62, 153.72, " di"], [153.72, 154.32, " verifica,"], [156.04, 156.04, " quello"], [156.04, 156.22, " che"], [156.22, 156.38, " ci"], [156.38, 156.76, " interessa"], [156.76, 156.94, " è"], [156.94, 157.04, " che"], [157.04, 157.24, " c"], [157.24, 157.28, "'è"], [157.28, 157.5, " una"]]}, {"start": 157.5, "end": 163.36, "text": "motivazione. C'è un soggetto che ha deciso che lì fosse necessario", "words": [[157.5, 158.36, " motivazione."], [158.74, 158.74, " C"], [158.74, 159.1, "'è"], [159.1, 159.26, " un"], [159.26, 159.96, " soggetto"], [159.96, 160.42, " che"], [160.42, 160.92, " ha"], [160.92, 161.56, " deciso"], [161.56, 161.68, " che"], [161.68, 162.0, " lì"], [162.0, 162.7, " fosse"], [162.7, 163.36, " necessario"]]}, {"start": 163.36, "end": 166.42, "text": "installare una videocamera e registrare quello che succede.", "words": [[163.36, 164.02, " installare"], [164.02, 164.28, " una"], [164.28, 164.94, " videocamera"], [164.94, 165.16, " e"], [165.16, 165.66, " registrare"], [165.66, 165.84, " quello"], [165.84, 165.98, " che"], [165.98, 166.42, " succede."]]}, {"start": 168.2, "end": 174.68, "text": "Questo primo punto ci suggerisce investiga un approfondimento, un", "words": [[168.2, 168.92, " Questo"], [168.92, 169.64, " primo"], [169.64, 170.32, " punto"], [170.32, 170.76, " ci"], [170.76, 171.46, " suggerisce"], [171.46, 171.46, " investiga"], [171.46, 172.3, " un"], [172.3, 174.42, " approfondimento,"], [174.56, 